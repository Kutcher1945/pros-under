# Mapbox public (pk.) token for the login page background maps — client-side by design.
NEXT_PUBLIC_MAPBOX_TOKEN=
# prosecutor-backend base URL (no trailing slash). Local dev: http://localhost:8000 (also the
# default under `yarn dev` when unset); production e.g. https://pros-admin.smartalmaty.kz
NEXT_PUBLIC_BACKEND_API_URL=
